#!/usr/bin/env ruby
# 使い方: bin/bench <workload> <out.json>
# 1プロセスで1ワークロードだけを測る。前のワークロードで温まったJITが次の計測に混ざらないようにするため。
WORKLOAD = ARGV.fetch(0)
OUT = ARGV.fetch(1)
WARMUP_SEC = Integer(ENV.fetch("WARMUP_SEC", "300"))
MEASURE_SEC = Integer(ENV.fetch("MEASURE_SEC", "15"))
THREADS = ENV.fetch("THREADS", "").split(",").map { Integer(it) }
PARALLEL_WARMUP_SEC = Integer(ENV.fetch("PARALLEL_WARMUP_SEC", "120"))

require_relative "../config/environment"
require_relative "../lib/workload"

def now = Workload.now

def rss_mb(key) = File.read("/proc/self/status")[/^#{key}:\s+(\d+)/, 1].to_i / 1024.0

# n 本のスレッドで sec 秒まわし、合計の処理件数を返す
def run_threads(n, sec, base)
  stop_at = now + sec
  n.times.map do |ti|
    Thread.new do
      local = base + (ti * 100_000)
      count = 0
      until now >= stop_at
        Workload.call(WORKLOAD, local += 1)
        count += 1
      end
      count
    end
  end.sum(&:value)
end

Workload.setup_db
seq = 0

# ウォームアップ: 1秒ごとの処理件数を曲線として残す
warmup = Workload.curve(WORKLOAD, WARMUP_SEC, seq)
seq += 10_000_000

# 定常計測: 1リクエストずつの所要時間を記録する
lat = []
deadline = now + MEASURE_SEC
while now < deadline
  t = now
  Workload.call(WORKLOAD, seq += 1)
  lat << (now - t)
end
sorted = lat.sort
pct = ->(q) { sorted[((sorted.size - 1) * q).round] * 1000 }

# 並列: TruffleRuby は処理を別スレッドで回し始めると最適化済みのコードを捨てて作り直し、戻るまで60〜90秒かかる。
# その期間を計測に入れないよう、最大スレッド数で温めてからスレッド数ごとの合計処理件数を比べる。
parallel = []
unless THREADS.empty?
  run_threads(THREADS.max, PARALLEL_WARMUP_SEC, seq += 1_000_000)
  parallel = THREADS.map do |n|
    { threads: n, rps: run_threads(n, MEASURE_SEC, seq += 1_000_000) / MEASURE_SEC.to_f }
  end
end

result = {
  runtime: ENV.fetch("BENCH_RUNTIME"),
  ruby_description: RUBY_DESCRIPTION,
  yjit_enabled: defined?(RubyVM::YJIT) ? RubyVM::YJIT.enabled? : false,
  rails: Rails.version,
  database: ActiveRecord::Base.connection_db_config.adapter,
  workload: WORKLOAD,
  warmup_sec: WARMUP_SEC,
  measure_sec: MEASURE_SEC,
  parallel_warmup_sec: THREADS.empty? ? 0 : PARALLEL_WARMUP_SEC,
  warmup_rps: warmup,
  rps: lat.size / lat.sum,
  p50_ms: pct.(0.50),
  p99_ms: pct.(0.99),
  requests: lat.size,
  peak_rss_mb: rss_mb("VmHWM"),
  parallel: parallel
}
File.write(OUT, JSON.pretty_generate(result))
puts "#{result[:runtime]} #{result[:database]} #{WORKLOAD}: #{result[:rps].round(1)} req/s " \
     "p50=#{result[:p50_ms].round(2)}ms rss=#{result[:peak_rss_mb].round}MB"
